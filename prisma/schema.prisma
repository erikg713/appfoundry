// This is your Prisma schema file.
// Better Auth will extend this with its models via `npx @better-auth/cli generate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core AppFoundry models (to be expanded)
// Better Auth models (user, session, account, verification, organization, member, invitation)
// will be generated by the Better Auth CLI.

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  slug           String
  organizationId String?  // null = personal project
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations will be wired after Better Auth schema generation
  // organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, slug])
  @@index([organizationId])
}
